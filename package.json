{
  "name": "relativity-juice",
  "private": true,
  "scripts": {
    "test": "sh bin/quiet sh bin/blender -b --factory-startup --python-exit-code 1 --python tests/run.py",
    "test:only": "sh bin/quiet sh bin/blender -b --factory-startup --python-exit-code 1 --python tests/run.py --",
    "typecheck": "pyright",
    "smoke": "sh bin/quiet sh bin/blender -b --factory-startup --python-exit-code 1 --python scripts/smoke.py",
    "render": "sh bin/render",
    "render:status": "python3 -m src.status",
    "render:wait": "python3 -m src.status --wait",
    "encode": "python3 -m src.encode",
    "cards": "sh bin/quiet sh bin/blender -b --factory-startup --python-exit-code 1 --python scripts/cards.py",
    "racer": "sh bin/quiet sh bin/blender -b --factory-startup --python-exit-code 1 --python scripts/racer.py",
    "blend": "sh bin/quiet sh bin/blender -b --factory-startup --python-exit-code 1 --python scripts/blend.py",
    "media": "bun run cards && python3 -m src.media",
    "media:racer": "bun run cards && python3 -m src.media --racer",
    "wip": "sh bin/quiet sh bin/wip",
    "preview": "sh bin/quiet sh bin/preview",
    "still": "sh bin/quiet sh bin/blender -b --factory-startup --python-exit-code 1 --python scripts/still.py",
    "still:warp": "sh bin/quiet sh bin/blender -b --factory-startup --python-exit-code 1 --python scripts/still.py -- 0.1 0.9 0.999",
    "rear": "sh bin/quiet sh bin/blender -b --factory-startup --python-exit-code 1 --python scripts/rear.py --",
    "newton": "sh bin/quiet sh bin/blender -b --factory-startup --python-exit-code 1 --python scripts/newton.py",
    "rear:whip": "sh bin/quiet sh bin/blender -b --factory-startup --python-exit-code 1 --python scripts/whip.py",
    "hud": "sh bin/quiet sh bin/blender -b --factory-startup --python-exit-code 1 --python scripts/hud.py --",
    "still:beats": "sh bin/quiet sh bin/blender -b --factory-startup --python-exit-code 1 --python scripts/beats.py",
    "still:gauge": "sh bin/quiet sh bin/blender -b --factory-startup --python-exit-code 1 --python scripts/still.py -- 0.9"
  },
  "devDependencies": {
    "pyright": "^1.1.400"
  }
}
